# ===== 物流规划系统后端配置 =====

# 高德 Web 服务 key (用于真实路网距离矩阵)。留空则默认走 haversine 直线距离。
# 申请: https://lbs.amap.com/dev/key/app (服务类型选"Web服务")
AMAP_WEB_SERVICE_KEY=

# 距离提供者: haversine (直线距离, 默认) | amap_webservice (驾车路网距离, 需配上面的 key)
DISTANCE_PROVIDER=haversine

# CORS 允许的前端来源 (逗号分隔)
CORS_ORIGINS=http://localhost:5173

# 高德 JS API 安全密钥 (用于后端 serviceHost 代理，不泄露给前端)
AMAP_SECURITY_SECRET=
